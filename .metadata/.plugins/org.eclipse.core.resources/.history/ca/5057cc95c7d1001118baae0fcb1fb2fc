package mod;

import java.util.ArrayList;
import java.util.Iterator;
import java.util.List;

public class App {

	static void printStudents(List<Student> list) {
		Iterator<Student> itr = list.iterator();
		while (itr.hasNext()) {
			Student student = itr.next();
			System.out.print(student.getId() + "  ");
			System.out.print(student.getName() + "  ");
			System.out.println(student.getMarks() + "  ");
			System.out.println("-----------");
		}
	}

	public static void main(String[] args) {
		Student s1 = new Student(1, "Shah Rukh Khan", 95.5);
		Student s2 = new Student(2, "Salman Khan", 88.0);
		Student s3 = new Student(3, "Aamir Khan", 92.5);
		Student s4 = new Student(4, "Deepika Padukone", 89.5);
		Student s5 = new Student(5, "Ranbir Kapoor", 91.0);

		List<Student> jpa92 = new ArrayList<Student>();

		jpa92.add(s1);
		jpa92.add(s2);
		jpa92.add(s3);
		jpa92.add(s4);
		jpa92.add(s5);
		
		printStudents(jpa92);
		
		System.out.println("--------------------------------");
		Student s6 = new Student(4, "Deepika Padukone", 89.5);
		
		
		
		
	}
}
