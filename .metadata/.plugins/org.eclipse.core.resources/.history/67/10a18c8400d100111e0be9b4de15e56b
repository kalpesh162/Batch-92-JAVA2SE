package basic;

import java.util.ArrayList;
import java.util.ListIterator;

public class App1 {

	public static void main(String[] args) {

		ArrayList<String> friends = new ArrayList<String>();
		friends.add("Kareena");
		friends.add("Raveena");
		friends.add("Anup");
		friends.add("Katrina");
		friends.add("Rahul");

		// System.out.println(friends.get(10)); // java.lang.IndexOutOfBoundsException:
		// Index: 10, Size: 5

		friends.set(0, "Deepika");
		// When we want replace

		System.out.println(friends);

		friends.add(0, "Shraddha");

		// friends.add(10, "Shraddha"); java.lang.IndexOutOfBoundsException: Index: 10,
		// Size: 6

		System.out.println(friends);

		System.out.println("Remove  " + friends.remove(0));
		System.out.println(friends);

		System.out.println("-------------------------------------");

		//ListIterator<String> litr = friends.listIterator();

		ListIterator<String> litr = friends.listIterator(friends.size());
		while(litr.hasPrevious()) {
			System.out.println(litr.previous());
		}
		
		ListIterator<String> litr1 = friends.listIterator(friends.size());

		while(litr.hasNext()()) {
			System.out.println(litr.next()());
		}
		
		while(litr.hasPrevious()) {
			System.out.println(litr.previous());
		}
	}

}
